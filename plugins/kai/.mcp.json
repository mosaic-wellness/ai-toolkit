{
  "mcpServers": {
    "mosaic-mixpanel": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.mixpanel.com/mcp"]
    },
    "mosaic-firebase": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "mcp"]
    },
    "kai-mcp": {
      "type": "http",
      "url": "https://kai-orchestrator.api.mosaicwellness.in/mcp"
    },
    "mosaic-newrelic": {
      "type": "http",
      "url": "https://mcp.newrelic.com/mcp/",
      "headers": {
        "api-key": "${NEW_RELIC_API_KEY}"
      }
    },
    "admin-mcp": {
      "type": "http",
      "url": "https://stg-admin-mcp.mosaicwellness.in/mcp",
      "headers": {
        "x-api-key": "${ADMIN_MCP_API_KEY}"
      }
    }
  }
}
